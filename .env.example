APP_ENV=production
SITE_NAME=The Scentist
HOST=0.0.0.0
PORT=8780
BASE_URL=https://your-domain.example
DATABASE_URL=postgresql://app_user:app_password@db-host:5432/the_scentist
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSLMODE=require
DATABASE_POOL_MIN_SIZE=2
DATABASE_POOL_MAX_SIZE=12
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_STATEMENT_TIMEOUT_MS=5000
SQLITE_DATABASE_PATH=data/perfumery.sqlite3
SQLITE_BUSY_TIMEOUT_MS=5000
MAX_REQUEST_BODY_BYTES=262144
STATIC_CACHE_MAX_AGE_SECONDS=86400
AUTO_SEED_CATALOG=false
WEB_CONCURRENCY=4
WEB_THREADS=4
WEB_TIMEOUT_SECONDS=60
WEB_GRACEFUL_TIMEOUT_SECONDS=30
WEB_KEEPALIVE_SECONDS=5
WEB_MAX_REQUESTS=1000
WEB_MAX_REQUESTS_JITTER=100
LOG_LEVEL=info
PREVIEW_LABEL=
ASSET_VERSION=
STORE_CURRENCY=INR
STORE_DEFAULT_COUNTRY=India
SHIPPING_FEE_INR=350
FREE_SHIPPING_THRESHOLD_INR=12500
ORDER_PREFIX=TSC
ENABLE_MANUAL_CHECKOUT=true
PAYMENT_RESERVATION_MINUTES=30
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
APP_SECRET_KEY=generate_a_long_random_application_secret
REDIS_URL=redis://localhost:6379/0
ADMIN_TOKEN=generate_a_long_random_admin_token
ADMIN_EMAIL=orders@your-domain.example
NOTIFICATION_FROM_EMAIL=orders@your-domain.example
SMTP_HOST=smtp.your-provider.example
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
AI_CONCIERGE_ENABLED=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
